# ECMWF GIK Tutorial - Environment Configuration
# Copy this file to .env and fill in your values
#
# Used by: run_ecmwf_tutorial.py, stream_cgan_variables.py,
#          stream_cgan_variables_coiled_simple.py

# ── GCS Bucket Configuration ──────────────────────────────────────────
# Parquet files are stored at: gs://{GCS_BUCKET}/{GCS_PARQUET_PREFIX}/{YYYYMMDD_HHz}/
GCS_BUCKET=gik-ecmwf-aws-tf
GCS_PARQUET_PREFIX=run_par_ecmwf

# ── GCS Authentication ────────────────────────────────────────────────
# Path to GCS service account JSON file.
# If the file is not found, scripts fall back to Application Default Credentials (ADC).
GCS_SERVICE_ACCOUNT_FILE=coiled-data.json

# ── Coiled Configuration (for parallel cloud processing) ──────────────
COILED_WORKSPACE=gcp-sewaa-nka
COILED_REGION=us-east1

# ── Source.coop AWS STS Credentials (for ecmwf_ea_tp_source_coop.py) ──
# Get fresh temporary credentials from source.coop dashboard (valid ~1 hour).
# The script parses shell export format — keep the 'export' prefix.
#export AWS_ACCESS_KEY_ID="ASIA..."
#export AWS_SECRET_ACCESS_KEY="..."
#export AWS_SESSION_TOKEN="..."
#export AWS_DEFAULT_REGION="us-west-2"
