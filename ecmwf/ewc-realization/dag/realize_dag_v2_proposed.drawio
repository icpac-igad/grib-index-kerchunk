<mxfile host="app.diagrams.net" version="24.0.0"><diagram name="realize-dag-v2-proposed" id="realize-dag-v2"><mxGraphModel dx="1500" dy="950" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="950" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1" value="realize DAG v2 (PROPOSED) &#8212; warm the read path; shape unchanged from v1" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="980" height="30" as="geometry"/></mxCell><mxCell id="t2" value="v1 resolves every one of ~126,000 chunk references per date lazily, one at a time, mid-read. The path warms 2.56&#215; within a&#10;process and a build never benefits, because it reads each message exactly once. Purple = the only change." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="980" height="42" as="geometry"/></mxCell><mxCell id="s1" value="source.coop&#10;virtual icechunk store&#10;&lt;i&gt;manifest &#8594; byte range&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="180" height="80" as="geometry"/></mxCell><mxCell id="s2" value="s3://ecmwf-forecasts&#10;one ~6.5 GB object per step" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="230" width="180" height="70" as="geometry"/></mxCell><mxCell id="pw" value="PRELOAD, bounded&#10;&lt;i&gt;cover one date&#8217;s working set&#10;at open, not 1000s of refs&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="270" y="130" width="250" height="70" as="geometry"/></mxCell><mxCell id="mc" value="manifest cache, per process&#10;&lt;i&gt;shared by the 51 members&#10;of one (channel, step)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="270" y="220" width="250" height="70" as="geometry"/></mxCell><mxCell id="lp" value="for channel in 38:&#10;  for step in 65:   &lt;i&gt;unchanged&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9673a6;dashed=1;fontSize=11;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="580" y="120" width="320" height="290" as="geometry"/></mxCell><mxCell id="r0" value="read_message(ch, step, member=0)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="610" y="160" width="260" height="30" as="geometry"/></mxCell><mxCell id="rd" value="&#8230;  50 more, all reusing the cache  &#8230;" style="text;html=1;align=center;fontSize=10;fontColor=#555;" vertex="1" parent="1"><mxGeometry x="610" y="196" width="260" height="22" as="geometry"/></mxCell><mxCell id="r2" value="read_message(ch, step, member=50)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="610" y="222" width="260" height="30" as="geometry"/></mxCell><mxCell id="fd" value="stack_members(*51)&#10;&lt;i&gt;unchanged&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="610" y="290" width="260" height="40" as="geometry"/></mxCell><mxCell id="w1" value="write_block &#8594; ForkSession &#8594; merge" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="610" y="350" width="260" height="36" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="s1" target="pw"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="pw" target="mc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="byte ranges, no round-trip" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="mc" target="r0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="bytes" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="s2" target="r2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="r0" target="fd"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="r2" target="fd"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="fd" target="w1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="nA" value="MEASURED 2026-10-05 &#8212; the warmup, 200 readers, 5 VMs, 0 failures&#10;&#10;pass   1     2     3     4     5&#10;msg/s  140   266   329   346   359        2.56&#215; cold &#8594; warm&#10;MB/s   110   210   260   273   283&#10;&#10;Warm = 57 MB/s per VM, which EXCEEDS the ~50 MB/s procs_probe figure." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;fontSize=10;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="500" height="120" as="geometry"/></mxCell><mxCell id="nB" value="It is NOT S3 caching the bytes &#8212; disjoint-set test&#10;&#10;pass 1  set X, cold                 196 msg/s&#10;pass 2  set Y, byte ranges NEVER fetched   272      &#8592; 39% faster&#10;pass 3  set X again                 296&#10;pass 4  set Y again                 338&#10;&#10;Warmth is a property of the PROCESS, not the data, so it generalises&#10;to the read-each-message-once case a build is permanently in." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;fontSize=10;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="465" width="500" height="120" as="geometry"/></mxCell><mxCell id="nC" value="WHY v1 NEVER WARMS&#10;&#10;Every call site disables preload:&#10;  ManifestPreloadConfig(max_total_refs=0,&#10;                        max_arrays_to_scan=0)&#10;&#10;That was a real fix &#8212; the default prefetches&#10;thousands of manifests and source.coop&#8217;s&#10;sporadic 500s aborted the open. The cost is&#10;lazy per-reference resolution forever.&#10;A BOUNDED preload is the first thing to try." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;fontSize=10;" vertex="1" parent="1"><mxGeometry x="930" y="120" width="330" height="150" as="geometry"/></mxCell><mxCell id="nD" value="CAVEAT &#8212; not yet separated&#10;&#10;Manifest resolution and TCP/TLS connection&#10;reuse both warm per-process and both fit&#10;this curve. The fixes share no code:&#10;&#10;  manifests  -> bounded preload + group cache&#10;  connections -> larger pool, keep-alives&#10;&#10;Separate them before building. An attempt to&#10;do so gave unusable numbers (rates from task&#10;count, not successes; mismatched msg sizes)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;fontSize=10;" vertex="1" parent="1"><mxGeometry x="930" y="285" width="330" height="150" as="geometry"/></mxCell><mxCell id="nE" value="RETIRED as ceilings &#8212; all measured&#10;&#10;AWS request quota   0 errors at 100/200/400&#10;per-object hot key  concentrated is 15% FASTER&#10;shared EWC path     carried 216.5 MB/s, 0&#215;503&#10;per-VM bandwidth    warm 57 &gt; ~50 MB/s&#10;&#10;Adding machines would not have helped. The&#10;bottleneck was never throughput." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;fontSize=10;dashed=1;" vertex="1" parent="1"><mxGeometry x="930" y="450" width="330" height="135" as="geometry"/></mxCell><mxCell id="nF" value="PRIZE&#10;&#10;at fixed concurrency, warmth alone&#10;    196 -&gt; 338 msg/s  =  1.7&#215;&#10;&#10;upper bound if cold reached warm&#10;    243 h  -&gt;  ~95 h&#10;&#10;realistic: less. Not all of 2.56&#215; is&#10;manifest, and the split is unmeasured.&#10;&#10;UNCHANGED from v1: leaf unit, fan-in&#10;shape, submission order, write path." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;fontSize=10;dashed=1;" vertex="1" parent="1"><mxGeometry x="580" y="430" width="320" height="155" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>