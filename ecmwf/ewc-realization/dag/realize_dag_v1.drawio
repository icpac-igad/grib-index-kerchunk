<mxfile host="app.diagrams.net" version="24.0.0"><diagram name="realize-dag-v1" id="realize-dag-v1"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1" value="realize DAG v1 &#8212; one forecast date, 38 channels &#215; 51 members &#215; 65 steps" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="30" as="geometry"/></mxCell><mxCell id="t2" value="Validated by 1,260 dates / 243.0 cluster-hours across 16 seasons. 934 retries in ~156M messages (5.9 per million).&#10;Submission order is channel-major &#8594; step &#8594; member, which is deliberate: see note C." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="900" height="40" as="geometry"/></mxCell><mxCell id="s1" value="source.coop&#10;virtual icechunk store&#10;&lt;i&gt;manifest &#8594; byte range&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="180" height="70" as="geometry"/></mxCell><mxCell id="s2" value="s3://ecmwf-forecasts&#10;one ~6.5 GB object per step&#10;&lt;i&gt;all 51 members inside&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="210" width="180" height="70" as="geometry"/></mxCell><mxCell id="lp" value="for channel in 38:&#10;  for step in 65:" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9673a6;dashed=1;fontSize=11;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="270" y="110" width="330" height="290" as="geometry"/></mxCell><mxCell id="r0" value="read_message(ch, step, member=0)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="300" y="150" width="230" height="34" as="geometry"/></mxCell><mxCell id="r1" value="read_message(ch, step, member=1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="300" y="192" width="230" height="34" as="geometry"/></mxCell><mxCell id="rd" value="&#8230;  49 more  &#8230;" style="text;html=1;align=center;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="300" y="234" width="230" height="24" as="geometry"/></mxCell><mxCell id="r2" value="read_message(ch, step, member=50)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="300" y="264" width="230" height="34" as="geometry"/></mxCell><mxCell id="fd" value="stack_members(*51)&#10;&lt;i&gt;fan-in, not a reduction&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="300" y="330" width="230" height="40" as="geometry"/></mxCell><mxCell id="w1" value="write_block(fork, ch, t, step)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="650" y="330" width="230" height="40" as="geometry"/></mxCell><mxCell id="w2" value="ForkSession&#10;&lt;i&gt;pickled to each worker&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="650" y="400" width="230" height="50" as="geometry"/></mxCell><mxCell id="w3" value="merge &#8594; one commit per date&#10;&lt;i&gt;ceph must-icechunk&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="650" y="470" width="230" height="50" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="s1" target="r0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="s2" target="r1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="r0" target="fd"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="r1" target="fd"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="r2" target="fd"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="fd" target="w1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="w1" target="w2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="w2" target="w3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="nA" value="A &#8212; counts per date&#10;&#10;leaves    38 &#215; 51 &#215; 65 = 125,970&#10;fan-ins   38 &#215; 65 = 2,470 blocks&#10;chunk     (1, 1, 51, 321, 261) = 17.1 MB&#10;read      ~99 GB GRIB &#8594; kept ~17 GB" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;fontSize=10;dashed=1;" vertex="1" parent="1"><mxGeometry x="960" y="120" width="300" height="110" as="geometry"/></mxCell><mxCell id="nB" value="B &#8212; measured throughput&#10;&#10;48 readers   166 msg/s   3.46 / reader&#10;100 readers  143         1.43&#10;200 readers  207         1.03&#10;400 readers  227         0.57&#10;asymptote ~227 msg/s = 36 MB/s per VM" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;fontSize=10;dashed=1;" vertex="1" parent="1"><mxGeometry x="960" y="245" width="300" height="110" as="geometry"/></mxCell><mxCell id="nC" value="C &#8212; why channel-major, then step&#10;&#10;All 51 members of one step live in ONE&#10;object, so this ordering reads them with&#10;locality. Interleaving across step-files&#10;was tested and is 15% SLOWER&#10;(175 &#8594; 152 msg/s at 200 readers).&#10;The concentration is a feature." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;fontSize=10;dashed=1;" vertex="1" parent="1"><mxGeometry x="960" y="370" width="300" height="130" as="geometry"/></mxCell><mxCell id="nD" value="D &#8212; what is NOT the ceiling (measured 2026-10-04)&#10;&#10;AWS request quota   zero errors at 100 / 200 / 400 readers&#10;shared EWC path     carried 216.5 MB/s (1.73 Gbps), 0 &#215; 503&#10;per-VM capability   ~50 MB/s, and we asymptote at 36&#10;&#10;Remaining candidate: manifest resolution on source.coop. Never isolated." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;fontSize=10;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="560" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>