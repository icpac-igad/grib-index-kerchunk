# GEFS GIK — Environment Configuration
# Copy this file to .env and fill in your values.
#
# Used by: upload_parquets_to_hf.py
#
# The .env file is gitignored. Do NOT commit it.

# ── GCS Bucket Configuration ──────────────────────────────────────────
# Parquet files are stored at:
#   gs://${GCS_BUCKET}/run_par_gefs/{YYYY}/{MM}/{YYYYMMDD}/{run}z/*.parquet
GCS_BUCKET=your-bucket-name

# ── GCS Authentication ────────────────────────────────────────────────
# Path to GCS service account JSON file. If the file is missing, the
# script falls back to GOOGLE_APPLICATION_CREDENTIALS, then to
# Application Default Credentials.
GCS_SA_FILE=coiled-data.json

# ── HuggingFace Configuration ─────────────────────────────────────────
# Dataset repo id (created on first push if you have permission).
HF_REPO=E4DRR/gik-gefs-par

# Token from https://huggingface.co/settings/tokens — needs write access
# to the target repo / org.
HF_TOKEN=hf_xxx_replace_with_your_token
